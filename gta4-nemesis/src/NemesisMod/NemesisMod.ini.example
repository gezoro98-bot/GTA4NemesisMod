# NemesisMod.ini.example — скопируйте в NemesisMod.ini рядом с DLL (папка scripts).
# Все параметры необязательны; значения ниже — значения по умолчанию.

# Включать/выключать модули (1 = да, 0 = нет)
nemesis=1
gangwars=1
activities=1
missions=1
npcai=1

# Шанс случайной засады за проверку (в процентах)
ambush_chance=3

# Шанс случайной перестрелки за проверку (в процентах)
shootout_chance=5

# Минимальная пауза между случайными активностями (секунды)
activity_cooldown_sec=45

# Интервал автосохранения (секунды)
autosave_sec=60
