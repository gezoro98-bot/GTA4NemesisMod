<Project Sdk="Microsoft.NET.Sdk">

  <!--
    GTA IV ScriptHookDotNet (CE fork by Tomasak) hosts CLR4 scripts.
    Scripts must compile to .NET Framework 4.0 and be named *.net.dll.
    Drop ScriptHookDotNet.dll (x86) into ../lib before building.
  -->
  <PropertyGroup>
    <TargetFramework>net40</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>NemesisMod.net</AssemblyName>
    <RootNamespace>GTA4Nemesis</RootNamespace>
    <OutputType>Library</OutputType>
    <PlatformTarget>x86</PlatformTarget>
    <OutputPath>bin\Release\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Deterministic>false</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets dotnet build target net40 without Visual Studio installed. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="ScriptHookDotNet">
      <HintPath>..\lib\ScriptHookDotNet.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

</Project>
